		{"id":"bce486bf158d3ee6","type":"text","text":"Plan stworzony na podstawie Plików Kierunku ISIM","x":-2660,"y":-1753,"width":250,"height":87},
		{"id":"5b0ed4b9f262d19e","type":"text","text":"Cele:\n1. Minimalizajca ilości przedmiotów\n2. ŻADNYCH KURSÓW\n3. Wypełnienie minimalnych wymagań\n4. Zdobycie podstawowych zdolności programownia\n5. Posiadanie podstawowej wiedzy o AI","x":-765,"y":-2600,"width":300,"height":340},
